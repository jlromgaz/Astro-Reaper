rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public arcade leaderboard: anyone can read and append a shape-validated
    // score, nobody can edit or delete existing entries.
    match /scores/{entry} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'score', 'mode'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 8
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 9999999
        && request.resource.data.mode is string
        && request.resource.data.mode.size() <= 24;
      allow update, delete: if false;
    }
  }
}
