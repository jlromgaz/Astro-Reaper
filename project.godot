; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Astro Reaper"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6")

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameManager="*res://scripts/core/game_manager.gd"
DebugLog="*res://scripts/core/debug_log.gd"
SoundManager="*res://scripts/core/sound_manager.gd"
FXManager="*res://scripts/core/fx_manager.gd"
ScoreManager="*res://scripts/core/score_manager.gd"
Settings="*res://scripts/core/settings.gd"
Leaderboard="*res://scripts/core/leaderboard.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=3

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/test_width=480
window/size/test_height=270

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/translations.en.translation", "res://data/i18n/translations.es.translation")
locale/fallback="en"

