; Engine configuration file.
; Astro Reaper - Survivors-like space auto-shooter roguelite

config_version=5

[application]

config/name="Astro Reaper"
run/main_scene="res://scenes/main/main.tscn"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
GameManager="*res://scripts/core/game_manager.gd"
DebugLog="*res://scripts/core/debug_log.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/test_width=0
window/size/test_height=0

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/godot.log"
file_logging/max_log_files=3

[input]

move_up={
"deadzone": 0.5,
"events": []
}
move_down={
"deadzone": 0.5,
"events": []
}
move_left={
"deadzone": 0.5,
"events": []
}
move_right={
"deadzone": 0.5,
"events": []
}

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemies"
2d_physics/layer_3="PlayerBullets"
2d_physics/layer_4="EnemyBullets"
2d_physics/layer_5="Pickups"
2d_physics/layer_6="Obstacles"

[physics]

2d/default_gravity=0.0
2d/default_linear_damp=0.0

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
